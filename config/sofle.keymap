#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt { flavor = "tap-preferred"; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        mac {
            display-name = "mac";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC     &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                                               &kp N6  &kp N7      &kp N8     &kp N9    &kp N0         &kp MINUS
&kp TAB     &kp Q   &kp W      &kp E     &kp R     &kp T                                                &kp Y   &kp U       &kp I      &kp O     &kp P          &kp BSPC
&kp LSHIFT  &kp A   &kp S      &kp D     &kp F     &kp G                                                &kp H   &kp J       &kp K      &kp L     &kp SEMICOLON  &kp SQT
&kp GRAVE   &kp Z   &kp X      &kp C     &kp V     &kp B   &kp C_MUTE                 &kp C_PLAY_PAUSE  &kp N   &kp M       &kp COMMA  &kp DOT   &kp FSLH       &kp DELETE
                    &kp LCTRL  &kp LALT  &kp LCMD  &mo 3   &mt LA(LS(LCTRL)) SPACE    &kp ENTER         &mo 2   &kp RSHIFT  &kp RCMD   &kp RALT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        linux {
            display-name = "linux";
            bindings = <
&kp ESC    &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                                  &kp N6  &kp N7           &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W      &kp E     &kp R     &kp T                                   &kp Y   &kp U            &kp I      &kp O     &kp P     &kp BSPC
&kp LSHFT  &kp A   &kp S      &kp D     &kp F     &kp G                                   &kp H   &kp J            &kp K      &kp L     &kp SEMI  &kp SQT
&kp GRAVE  &kp Z   &kp X      &kp C     &kp V     &kp B   &kp C_MUTE    &kp C_PLAY_PAUSE  &kp N   &kp M            &kp COMMA  &kp DOT   &kp FSLH  &kp DELETE
                   &kp LCTRL  &kp LGUI  &kp LALT  &mo 3   &kp SPACE     &kp ENTER         &mo 2   &kp RIGHT_SHIFT  &kp RCTRL  &kp RALT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav {
            display-name = "nav";
            bindings = <
&kp LC(LS(SPACE))  &kp F1  &kp F2            &kp F3        &kp F4      &kp F5                               &kp F6           &kp F7             &kp F8        &kp F9           &kp F10     &kp F11
&kp LC(LG(Q))      &none   &none             &none         &none       &none                                &kp HOME         &kp END            &kp PAGE_UP   &kp PAGE_DOWN    &kp INSERT  &kp F12
&caps_word         &none   &none             &none         &none       &kp ENTER                            &kp LEFT_ARROW   &kp DOWN_ARROW     &kp UP_ARROW  &kp RIGHT_ARROW  &none       &none
&kp CAPSLOCK       &none   &none             &none         &kp DELETE  &kp BACKSPACE  &none          &none  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE    &none            &none       &none
                           &kp LS(LEFT_GUI)  &kp LS(LALT)  &kp LALT    &trans         &key_repeat    &none  &trans           &none              &none         &none
            >;

            label = "nav";
        };

        symbol {
            display-name = "symbol";
            bindings = <
&none  &none  &none  &none  &none           &kp LESS_THAN                           &kp GREATER_THAN       &kp PIPE   &none  &none  &none  &none
&none  &none  &none  &none  &kp BACKSLASH   &kp LBRC                                &kp RBRC               &kp SLASH  &none  &none  &none  &none
&none  &none  &none  &none  &kp MINUS       &kp LBKT                                &kp RBKT               &kp COLON  &none  &none  &none  &none
&none  &none  &none  &none  &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &none     &none   &kp RIGHT_PARENTHESIS  &kp EQUAL  &none  &none  &none  &none
              &none  &none  &none           &trans                &trans    &trans  &trans                 &none      &none  &none
            >;
        };

        adjust {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none        &none  &none  &none  &none  &none
&ext_power EP_TOG  &none         &none         &none         &none         &none                           &none        &none  &none  &none  &none  &none
&none              &none         &none         &none         &none         &bootloader                     &bootloader  &none  &none  &none  &none  &none
&soft_off          &none         &none         &none         &none         &sys_reset    &none     &none   &sys_reset   &none  &none  &none  &none  &none
                                 &none         &none         &none         &trans        &tog 0    &tog 1  &trans       &none  &none  &none
            >;
        };
    };
};
